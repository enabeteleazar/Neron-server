[Unit]
Description=NéronOS LLM API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neronOS/server
EnvironmentFile=-/etc/neronOS/secrets.env
Environment=NERON_ROOT=/etc/neronOS
Environment=NERON_CONFIG=/etc/neronOS/neron.yaml
Environment=NERON_CORE_URL=http://127.0.1.1:8010
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/etc/neronOS:/etc/neronOS/server
Environment=NERON_SERVICE_HOST=127.0.1.2
Environment=NERON_SERVICE_PORT=8765
ExecStart=/etc/neronOS/venv/bin/python -m uvicorn llm.app:app --host 127.0.1.2 --port 8765
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
