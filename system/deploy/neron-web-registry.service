[Unit]
Description=NéronOS Web Registry Sidecar
After=network-online.target neron-core.service neron-web.service
PartOf=neron-web.service

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neron
EnvironmentFile=/etc/neron/secrets.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/etc/neron/server
Environment=NERON_SERVICE_PORT=8080
ExecStart=/etc/neron/venv/bin/python -m web_bridge.registry_runner
Restart=always
RestartSec=10

[Install]
WantedBy=neron-web.service
