[Unit]
Description=Neron Core API
After=network.target

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neron
Environment=PYTHONPATH=/etc/neron/server
EnvironmentFile=/etc/neron/secrets.env
ExecStart=/etc/neron/venv/bin/uvicorn core.app:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
