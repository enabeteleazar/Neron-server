[Unit]
Description=NéronOS Core API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neronOS/server
EnvironmentFile=-/etc/neronOS/secrets.env
Environment=NERON_ROOT=/etc/neronOS
Environment=NERON_CONFIG=/etc/neronOS/neron.yaml
Environment=NERON_LLM_URL=http://127.0.1.2:8765/llm
Environment=NERON_LLM_TIMEOUT=240
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/etc/neronOS:/etc/neronOS/server
ExecStart=/etc/neronOS/venv/bin/python -m uvicorn core.app:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
