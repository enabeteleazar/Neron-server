[Unit]
Description=NéronOS Web (Next.js)
After=network-online.target neron-core.service
Requires=neron-core.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neronOS/client/client
Environment=NODE_ENV=production
# Prérequis : npm run build exécuté au déploiement (voir DEPLOY)
ExecStart=/usr/bin/npm run start -- --hostname 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
