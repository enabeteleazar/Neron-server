[Unit]
Description=Neron Web
After=network.target neron-core.service
Requires=neron-core.service

[Service]
Type=simple
User=neron
WorkingDirectory=/etc/neron/web/neron-app
Environment=NODE_ENV=development
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
