# Environnement d'execution commun aux services NeronOS.
# La topologie (hotes, ports) n'est PAS ici : elle vit dans neron.server.yaml.
NERON_ROOT=/etc/neronOS
NERON_CONFIG=/etc/neronOS/neron.yaml
PYTHONUNBUFFERED=1
PYTHONPATH=/etc/neronOS:/etc/neronOS/server

# Timeout de Core vers le service LLM. L'orchestrateur ajoute +10 s par-dessus
# (soit 100 s). Etait 240 s : l'utilisateur attendait jusqu'a 4 minutes sans
# retour, ce qui est le pire des echecs — on ne sait pas si ca repond ou si
# c'est casse.
#
# Ce plafond ne couvre PLUS le pire cas du service LLM. neron.yaml llm.timeout
# est passe de 45 s a 120 s le 04/09/2026 pour le juge memoire ; avec
# MAX_RETRIES=2 (server/llm/core/manager.py) le service LLM peut donc occuper
# jusqu'a 240 s, et Core abandonne avant. C'est un arbitrage assume et non un
# oubli : une reponse de conversation revient en 10 a 30 s, et rendre la main
# a 100 s vaut mieux que faire patienter 4 minutes. Le travail perdu l'est
# cote LLM, pas cote utilisateur.
#
# Le juge memoire n'est pas concerne : il appelle le service LLM directement
# avec son propre timeout (server/memory/app.py), sans passer par Core.
NERON_LLM_TIMEOUT=90

NERON_REGISTRY_STALE_TIMEOUT_SECONDS=45
NERON_REGISTRY_STALE_INTERVAL_SECONDS=15
