[Unit]
Description=neron-core dashboard
After=network.target neron@core.service
Requires=neron@core.service

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neronOS/client/dashboard
Environment=HOME=/home/neron
Environment=PATH=/home/neron/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PORT=4400
Environment=NERON_SECRETS_PATH=/etc/neronOS/secrets.env
ExecStartPre=/usr/bin/pnpm build
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
