[Unit]
Description=NeronOS
Documentation=https://github.com/enabeteleazar/neronOS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/srv/homelab/server-1/neronOS/server
Environment=NERON_ROOT=/srv/homelab/server-1/neronOS
Environment=NERON_CONFIG=/srv/homelab/server-1/neronOS/neron.yaml
Environment=PYTHONPATH=/srv/homelab/server-1/neronOS/server
Environment=NERON_IDENTITY_PATH=/srv/homelab/server-1/neronOS/server/memory/obsidian/identity/NERON.md
Environment=NERON_PLANS_PATH=/srv/homelab/server-1/neronOS/data/plans.jsonl
ExecStart=/srv/homelab/server-1/neronOS/venv/bin/python -m uvicorn core.app:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
