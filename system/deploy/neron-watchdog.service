[Unit]
Description=Néron Watchdog
After=network.target neron-core.service neron-doctor.service neron-llm.service
Requires=neron-core.service

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neron
EnvironmentFile=/etc/neron/secrets.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/etc/neron/server
Environment=NERON_SERVICE_PORT=8050
ExecStart=/etc/neron/venv/bin/uvicorn watchdog.app:app --host 127.0.0.1 --port 8050
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
