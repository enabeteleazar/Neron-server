[Unit]
# LEGACY: do not install for the current Neron OS runtime.
# This unit points to the old `server.core.app:app` import path.
# Use `deploy/neron-core.service` / `neron-core.service` instead.
Description=Legacy Core API service - server.core path
After=network.target

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neron
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/etc/neron/server
ExecStart=/etc/neron/venv/bin/uvicorn server.core.app:app --host 0.0.0.0 --port 8010 --workers 1
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
