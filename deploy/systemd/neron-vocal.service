[Unit]
Description=Neron Vocal — Interface vocale Next.js HTTPS
After=network.target neron-core.service

[Service]
Type=simple
User=neron
WorkingDirectory=/etc/neron/ui_vocal
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neron-vocal

[Install]
WantedBy=multi-user.target
