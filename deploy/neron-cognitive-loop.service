[Unit]
Description=Néron Cognitive Loop
After=network.target neron-core.service

[Service]
Type=simple

User=neron
WorkingDirectory=/etc/neron

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/etc/neron

ExecStart=/etc/neron/venv/bin/python /etc/neron/core/autonomous/run_cognitive_loop.py

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
