[Unit]
Description=NéronOS Voice Daemon (STT/TTS)
After=network-online.target neronOS.service
Wants=network-online.target

[Service]
Type=simple
User=neron
Group=neron-dev
WorkingDirectory=/etc/neronOS/server
EnvironmentFile=-/etc/neronOS/secrets.env
Environment=NERON_ROOT=/etc/neronOS
Environment=NERON_CONFIG=/etc/neronOS/neron.yaml
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/etc/neronOS:/etc/neronOS/server
Environment=NERON_SERVICE_PORT=8045
ExecStart=/etc/neronOS/venv/bin/python -m uvicorn voice.app:app --host 127.0.1.5 --port 8045
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
