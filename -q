    pipeline/nlp/
      fuzzy.py              — Levenshtein + trigrammes, zero deps, cache LRU
      intent_classifier.py  — Score hybride : exact keyword + fuzzy (CPU only)
      entity_extractor.py   — Extraction regex (location, device, room,
                              topic, task, time_ref, value)
      context_manager.py    — Mémoire duale : hot cache TTL 30min +
                              cold store SQLite cross-restart ;
                              résolution anaphorique + extraction de faits implicites
      orchestrator_plan.py  — Split commandes multi-action (séquentiel/parallèle)
      nlp_processor.py      — Point d'entrée NLP, retourne NLPResult structuré
    
    pipeline/orchestrator.py
      — Boucle de décision : confidence ≥ 0.40 → agent / en dessous → LLM fallback
      — Retry automatique ×2 avec timeout 30s par action
      — Exécution multi-action séquentielle ou parallèle (asyncio.gather)
      — Persistance SQLite de chaque tour après réponse
    
    memory/persistent_store.py
      — SQLite WAL, thread-safe (Lock + contextmanager)
      — Tables : sessions / turns / facts avec GC automatique (30j TTL)
      — build_context_summary() pour injection contextuelle dans le LLM
    
    app.py
      — Import + instanciation NLPOrchestrator + PersistentStore au lifespan
      — Routing multi-action via orchestrateur dans /input/text
      — Endpoint POST /nlp/parse exposé (debug + intégration)
    
    pipeline/intent/intent_router.py
